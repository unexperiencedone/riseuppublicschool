# ─────────────────────────────────────────────────────────────
# Rise UP Public School — API environment
# Copy to .env and fill in real values. NEVER commit .env
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# --- Database (MongoDB Atlas) ---
MONGODB_URI=mongodb://127.0.0.1:27017/riseup_school
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/riseup_school_test

# --- CORS ---
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5173

# --- Auth (JWT) ---
JWT_ACCESS_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_another_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
BCRYPT_ROUNDS=10

# --- Seed / bootstrap admin ---
SEED_ADMIN_EMAIL=riseuppublicschool48@gmail.com
SEED_ADMIN_PASSWORD=ChangeMe@123
SEED_ADMIN_NAME=School Administrator

# --- File storage: local | cloudinary ---
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=riseup-school

# --- Email (Nodemailer / Gmail SMTP or Brevo) ---
MAIL_DRIVER=log            # log | smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=riseuppublicschool48@gmail.com
SMTP_PASS=
MAIL_FROM="Rise UP Public School <riseuppublicschool48@gmail.com>"
MAIL_ADMIN_INBOX=riseuppublicschool48@gmail.com

# --- SMS (MSG91 - DLT registered, India) ---
SMS_DRIVER=log             # log | msg91
MSG91_AUTH_KEY=
MSG91_SENDER_ID=RUPSCH
MSG91_ROUTE=4
MSG91_TEMPLATE_ENQUIRY=
MSG91_TEMPLATE_RESULT=
MSG91_TEMPLATE_FEE=

# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_DRIVER=log        # log | meta
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_TEMPLATE_NAMESPACE=

# --- Payments (Razorpay) ---
PAYMENTS_DRIVER=mock       # mock | razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
PUBLIC_FORM_LIMIT_MAX=10
